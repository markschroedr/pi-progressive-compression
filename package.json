{
  "name": "pi-progressive-compression",
  "version": "0.1.0",
  "description": "Continuous context for Pi with progressive compression and recoverable originals",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/pi.mjs"
  },
  "bin": {
    "pi-progressive-compression": "scripts/pi.mjs"
  },
  "files": [
    "assets",
    "src",
    "scripts",
    "patches",
    "INSTALL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
